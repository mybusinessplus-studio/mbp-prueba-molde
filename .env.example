# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.
# Las variables NEXT_PUBLIC_ llegan al navegador: jamás poner secretos en ellas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca en el frontend ni en variables NEXT_PUBLIC_:
SUPABASE_SECRET_KEY=
